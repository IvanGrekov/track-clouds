{
    "type": "json_schema",
    "name": "telegram_mobility_observation",
    "strict": true,
    "schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
            "decision",
            "location",
            "event",
            "reason_code",
            "reason"
        ],
        "properties": {
            "decision": {
                "type": "string",
                "enum": ["accept", "reject"]
            },
            "location": {
                "type": ["string", "null"]
            },
            "event": {
                "type": ["string", "null"]
            },
            "reason_code": {
                "type": ["string", "null"],
                "enum": [
                    "spam_or_scam",
                    "unrelated_content",
                    "only_opinion_or_emotion",
                    "political_commentary",
                    null
                ]
            },
            "reason": {
                "type": ["string", "null"]
            }
        }
    }
}
