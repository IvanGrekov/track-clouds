# Create these credentials at https://my.telegram.org/apps
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=replace_with_your_api_hash

# Generate a dedicated string with: telegram-monitor generate-session
# Treat it like a password. Do not reuse a session that is running in another process.
TELEGRAM_SESSION_STRING=replace_with_a_dedicated_session_string

# Optional. Required only when config.toml has notification_mode = "bot".
# Create a bot with @BotFather. After the monitor starts, every recipient must
# open that bot and send /start. The first 10 users will be subscribed.
TELEGRAM_BOT_TOKEN=replace_with_your_bot_token

# Optional logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Optional. Defaults to config.toml in the current working directory.
# MONITOR_CONFIG_FILE=~/.config/telegram-monitor/config.toml
